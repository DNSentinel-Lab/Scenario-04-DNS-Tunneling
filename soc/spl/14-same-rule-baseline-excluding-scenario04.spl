index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=query client_ip=10.50.30.20
| eval qname_normalized=lower(rtrim(qname,"."))
| where NOT like(qname_normalized, "%.tunnel.soclab.abdul4rehman215.tech")
| eval labels=split(qname_normalized,".")
| eval first_label=mvindex(labels,0)
| eval first_label_length=len(first_label)
| eval parent_domain=mvjoin(mvindex(labels,1,-1),".")
| bin _time span=1m
| stats count as query_count dc(qname_normalized) as unique_qnames dc(first_label) as unique_child_labels count(eval(first_label_length>16)) as long_label_count max(first_label_length) as max_first_label_length values(qtype) as qtypes by _time parent_domain
| where unique_child_labels>=5 AND long_label_count>=5 AND max_first_label_length>16
| sort 0 _time
