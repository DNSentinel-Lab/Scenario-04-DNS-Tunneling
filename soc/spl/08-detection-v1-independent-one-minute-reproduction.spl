index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=query
| eval qname_normalized=lower(rtrim(qname,"."))
| where like(qname_normalized, "%.tunnel.soclab.abdul4rehman215.tech")
| eval first_label=mvindex(split(qname_normalized,"."),0)
| eval first_label_length=len(first_label)
| eval parent_domain=replace(qname_normalized,"^[^.]+\\.","")
| bin _time span=1m
| stats count as query_count dc(qname_normalized) as unique_qnames dc(first_label) as unique_child_labels count(eval(first_label_length>16)) as long_label_count max(first_label_length) as max_first_label_length values(qtype) as qtypes values(first_label) as child_labels by _time client_ip parent_domain
| sort 0 _time
