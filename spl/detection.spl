index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type="query"
| eval qname=lower(rtrim(qname,"."))
| eval labels=split(qname,".")
| eval first_label=mvindex(labels,0)
| eval parent_domain=mvjoin(mvindex(labels,1,-1),".")
| eval qname_length=len(qname)
| eval first_label_length=len(first_label)
| eval event_epoch=_time
| bin _time span=1m
| stats
    min(event_epoch) as first_event
    max(event_epoch) as last_event
    count as query_count
    dc(qname) as unique_qnames
    dc(first_label) as unique_child_labels
    avg(qname_length) as avg_qname_length
    max(qname_length) as max_qname_length
    avg(first_label_length) as avg_first_label_length
    max(first_label_length) as max_first_label_length
    count(eval(first_label_length>16)) as long_label_count
    values(qtype) as qtypes
    values(qname) as qname_samples
    by _time client_ip parent_domain
| where unique_child_labels>=5
    AND long_label_count>=5
    AND max_first_label_length>16
| eval detection_name="Possible DNS Tunneling Behavior"
| eval detection_version="1.0"
| eval alert_name="Scenario 04 - Possible DNS Tunneling Behavior"
| eval severity="medium"
| eval mitre_technique="T1071.004"
| eval scenario_id="scenario-04-dns-tunneling"
| eval scenario=scenario_id
| eval ai_profile="dns_tunneling_v1"
| eval rationale="Multiple fresh long child labels concentrated beneath the same parent domain in a short time window."
| eval event_time=first_event
| eval source="unbound:dns"
| eval human_validation_required="true"
| eval alert_id=scenario_id."|".client_ip."|".parent_domain."|".tostring(event_time)
| eval evidence_json=json_object(
    "detection_name", detection_name,
    "detection_version", detection_version,
    "ai_profile", ai_profile,
    "client_ip", client_ip,
    "parent_domain", parent_domain,
    "first_event", first_event,
    "last_event", last_event,
    "query_count", query_count,
    "unique_qnames", unique_qnames,
    "unique_child_labels", unique_child_labels,
    "avg_qname_length", avg_qname_length,
    "max_qname_length", max_qname_length,
    "avg_first_label_length", avg_first_label_length,
    "max_first_label_length", max_first_label_length,
    "long_label_count", long_label_count,
    "qtypes", mvjoin(qtypes,","),
    "qname_samples", mvjoin(qname_samples,","),
    "severity", severity,
    "mitre_technique", mitre_technique,
    "rationale", rationale,
    "scenario_id", scenario_id,
    "human_validation_required", human_validation_required
)
| convert ctime(first_event) ctime(last_event)
| table
    detection_name
    detection_version
    alert_id
    alert_name
    first_event
    last_event
    event_time
    client_ip
    parent_domain
    query_count
    unique_qnames
    unique_child_labels
    avg_qname_length
    max_qname_length
    avg_first_label_length
    max_first_label_length
    long_label_count
    qtypes
    qname_samples
    severity
    rationale
    mitre_technique
    scenario_id
    scenario
    ai_profile
    source
    human_validation_required
    evidence_json
| sort - unique_child_labels - max_first_label_length
