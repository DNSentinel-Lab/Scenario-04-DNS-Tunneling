index=dns_soc_aws sourcetype=aws:cloudwatchlogs:vpcflow
earliest="09/02/2026:16:37:19" latest="09/02/2026:16:38:30"
| rex field=_raw "^\S+\s+\S+\s+\S+\s+(?<srcaddr>\S+)\s+(?<dstaddr>\S+)\s+(?<srcport>\d+)\s+(?<dstport>\d+)\s+(?<protocol>\d+)\s+(?<packets>\d+)\s+(?<bytes>\d+)"
| where srcaddr="10.50.30.20"
| where dstport!=53 AND dstport!=123
| table _time srcaddr dstaddr srcport dstport protocol packets bytes
| sort _time
