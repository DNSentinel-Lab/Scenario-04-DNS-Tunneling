  "dataSources": {
    "ds_YyEH0Vkk": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| stats count as total_dns_queries"
      },
      "name": "Total DNS Queries"
    },
    "ds_LGnlsD6k": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| stats dc(qname) as unique_qnames"
      },
      "name": "Unique Qnames"
    },
    "ds_E1CNPeqP": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| eval qname=lower(rtrim(qname,\".\"))\r\n| eval first_label=mvindex(split(qname,\".\"),0)\r\n| stats dc(first_label) as unique_child_labels"
      },
      "name": "Unique Child Labels"
    },
    "ds_uUFmwGE3": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| stats dc(client_ip) as active_clients"
      },
      "name": "Active Clients"
    },
    "ds_uDrMbhMp": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| timechart span=1m count as dns_queries"
      },
      "name": "DNS Queries per Minute"
    },
    "ds_bUI5irPa": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| eval qname=lower(rtrim(qname,\".\"))\r\n| eval first_label=mvindex(split(qname,\".\"),0)\r\n| eval first_label_length=len(first_label)\r\n| timechart span=1m\r\n    avg(first_label_length) as avg_first_label_length\r\n    max(first_label_length) as max_first_label_length"
      },
      "name": "First-Label Length Over Time"
    },
    "ds_eS3xmLxq": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"reply\"\r\n| stats count as responses by rcode\r\n| sort - responses"
      },
      "name": "Response Code Mix"
    },
    "ds_rFOrl3hy": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| stats count as queries by qtype\r\n| sort - queries"
      },
      "name": "Query Type Mix"
    },
    "ds_kxew4JUt": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| eval qname=lower(rtrim(qname,\".\"))\r\n| eval labels=split(qname,\".\")\r\n| eval parent_domain=mvjoin(mvindex(labels,1,-1),\".\")\r\n| stats\r\n    count as query_count\r\n    dc(qname) as unique_qnames\r\n    by parent_domain\r\n| sort - query_count\r\n| head 15"
      },
      "name": "Top Parent Domains"
    },
    "ds_SRpKkgyA": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| eval qname=lower(rtrim(qname,\".\"))\r\n| eval labels=split(qname,\".\")\r\n| eval first_label=mvindex(labels,0)\r\n| eval parent_domain=mvjoin(mvindex(labels,1,-1),\".\")\r\n| eval qname_length=len(qname)\r\n| eval first_label_length=len(first_label)\r\n| bin _time span=1m\r\n| stats\r\n    count as query_count\r\n    dc(qname) as unique_qnames\r\n    dc(first_label) as unique_child_labels\r\n    avg(qname_length) as avg_qname_length\r\n    max(qname_length) as max_qname_length\r\n    avg(first_label_length) as avg_first_label_length\r\n    max(first_label_length) as max_first_label_length\r\n    values(qtype) as qtypes\r\n    values(qname) as qname_samples\r\n    by _time client_ip parent_domain\r\n| sort - unique_child_labels - max_first_label_length - query_count"
      },
      "name": "DNS Behavior Window Summary"
    },
    "ds_vwJGeEnG": {
      "type": "ds.search",
      "options": {
        "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"query\"\r\n| eval qname=lower(rtrim(qname,\".\"))\r\n| eval labels=split(qname,\".\")\r\n| eval first_label=mvindex(labels,0)\r\n| eval parent_domain=mvjoin(mvindex(labels,1,-1),\".\")\r\n| eval qname_length=len(qname)\r\n| eval first_label_length=len(first_label)\r\n| table _time client_ip qname qtype parent_domain qname_length first_label first_label_length\r\n| sort - _time"
      },
      "name": "Raw DNS Investigation"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      },
      "ds.spl2": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      }
    },
    "visualizations": {
      "global": {
        "showProgressBar": true
      }
    }
  },
